# ===== Versions figées par l'enseignant (ne pas modifier) =====
LAKEHOUSE_IMAGE=ghcr.io/moejee/lakehouse-jupyter:2026.1
SUPERSET_IMAGE=ghcr.io/moejee/lakehouse-superset:2026.1
RUSTFS_VERSION=1.0.0
ICEBERG_REST_VERSION=1.10.0
TRINO_VERSION=476
POSTGRES_VERSION=16-alpine

# ===== Identifiants -- environnement LOCAL uniquement =====
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=lakehouse-secret
AWS_REGION=us-east-1
PG_USER=lakehouse
PG_PASSWORD=lakehouse
PG_DB=olist
JUPYTER_TOKEN=lakehouse
SUPERSET_SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire
SUPERSET_ADMIN_PASSWORD=admin

# ===== Ressources (machine de 8 Go : JUPYTER_MEM_LIMIT=3g) =====
JUPYTER_MEM_LIMIT=4g
TRINO_MEM_LIMIT=2g

# ===== Ports côté hôte (à changer en cas de conflit) =====
PORT_JUPYTER=8888
PORT_SPARK_UI=4040
PORT_STREAMLIT=8501
PORT_MLFLOW=5000
PORT_S3_API=9000
PORT_S3_CONSOLE=9001
PORT_CATALOG=8181
PORT_POSTGRES=5432
PORT_TRINO=8080
PORT_SUPERSET=8088
