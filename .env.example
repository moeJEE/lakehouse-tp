# ===== Versions figées par l'enseignant (ne pas modifier) =====
LAKEHOUSE_IMAGE=ghcr.io/moejee/lakehouse-jupyter:2026.2
SUPERSET_IMAGE=ghcr.io/moejee/lakehouse-superset:2026.2
AIRFLOW_IMAGE=ghcr.io/moejee/lakehouse-airflow:2026.2
RUSTFS_VERSION=1.0.0
ICEBERG_REST_VERSION=1.10.0
TRINO_VERSION=476
POSTGRES_VERSION=16-alpine
PROMETHEUS_VERSION=v3.2.1
STATSD_EXPORTER_VERSION=v0.28.0
CADVISOR_VERSION=v0.49.1
GRAFANA_VERSION=11.5.2
MARQUEZ_VERSION=0.50.0

# ===== Identifiants -- environnement LOCAL uniquement =====
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=lakehouse-secret
AWS_REGION=us-east-1
PG_USER=lakehouse
PG_PASSWORD=lakehouse
PG_DB=olist
JUPYTER_TOKEN=lakehouse
SUPERSET_SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire
SUPERSET_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_PASSWORD=admin

# ===== Ressources (machine de 8 Go : JUPYTER_MEM_LIMIT=3g) =====
JUPYTER_MEM_LIMIT=4g
TRINO_MEM_LIMIT=2g
AIRFLOW_MEM_LIMIT=3g

# ===== Ports côté hôte (à changer en cas de conflit) =====
PORT_JUPYTER=8888
PORT_SPARK_UI=4040
PORT_STREAMLIT=8501
PORT_MLFLOW=5000
PORT_S3_API=9000
PORT_S3_CONSOLE=9001
PORT_CATALOG=8181
# 15432 et non 5432 : le port 5432 est souvent pris (PostgreSQL local)
# ou réservé par Windows. Les conteneurs utilisent toujours 5432 entre eux.
PORT_POSTGRES=15432
PORT_TRINO=8080
PORT_SUPERSET=8088
PORT_AIRFLOW=8085
PORT_PROMETHEUS=9090
PORT_GRAFANA=3000
PORT_MARQUEZ=3001
