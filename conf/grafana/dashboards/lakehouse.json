{
 "uid": "lakehouse",
 "title": "Lakehouse — supervision",
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Tâches réussies (24 h)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(airflow_taches_reussies_total[24h]))"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Exécutions de DAG en échec (24 h)",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "red"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(airflow_execution_dag_duree_secondes_count{etat=\"failed\"}) or vector(0)) - (sum(airflow_execution_dag_duree_secondes_count{etat=\"failed\"} offset 24h) or vector(0))"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Mémoire totale des conteneurs",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(container_memory_working_set_bytes{name=~\"lakehouse-.*\"})"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Conteneurs du cours en marche",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(container_last_seen{name=~\"lakehouse-.*\"})"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Mémoire par conteneur",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "container_memory_working_set_bytes{name=~\"lakehouse-.*\"}",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Processeur par conteneur (cœurs utilisés)",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(container_cpu_usage_seconds_total{name=~\"lakehouse-.*\"}[1m])",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Durée des tâches Airflow",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "airflow_tache_duree_secondes{quantile=\"0.5\"}",
     "legendFormat": "{{dag_id}} / {{task_id}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Exécutions de DAG terminées, par état (cumul)",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (etat) (airflow_execution_dag_duree_secondes_count)",
     "legendFormat": "{{etat}}"
    }
   ]
  }
 ],
 "tags": [
  "tp3"
 ]
}
