# Travail personnel des étudiants : jamais versionné, jamais touché par git pull
notebooks/mon_travail/*
!notebooks/mon_travail/.gitkeep

# Configuration locale (copiée depuis .env.example)
.env

# Jupyter / Python
.ipynb_checkpoints/
__pycache__/
spark-warehouse/
metastore_db/
derby.log
mlruns/

# Données volumineuses (fournies séparément)
data/*
!data/.gitkeep
!data/olist/
data/olist/olist_geolocation_dataset.csv

# LaTeX
*.aux
*.log
*.out
*.toc
*.synctex.gz

# Corrigés : ne jamais publier
*_corrige*

# Artefacts dbt
target/
logs/
dbt_packages/
*.joblib

# Fichiers locaux de Spark (métastore créé par dbt)
metastore_db/
derby.log
spark-warehouse/
